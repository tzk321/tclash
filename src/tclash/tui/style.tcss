/* tclash TUI 样式：全部走主题变量，ansi-* 主题时跟随终端配色 */

Screen {
    background: $background;
}

#topbar {
    height: 4;
    border-title-background: $surface;
    border-subtitle-background: $surface;
    padding: 0 1;
    border: round $primary 45%;
    background: $surface;
    border-title-align: left;
    border-subtitle-align: right;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 38;
    border-title-background: $surface;
    border-subtitle-background: $surface;
    border-subtitle-color: $text-muted;
    border: round $primary 30%;
    background: $surface;
    border-title-align: left;
    border-subtitle-align: right;
}

#main {
    width: 1fr;
    border-title-background: $surface;
    border-subtitle-background: $surface;
    border-subtitle-color: $text-muted;
    border: round $primary 30%;
    background: $surface;
    border-title-align: left;
    border-subtitle-align: right;
}

SpringList {
    height: 1fr;
    background: transparent;
}

#sidebar SpringList {
    padding: 0 0;
}

#proxies {
    padding: 0 1;
}

#filter {
    height: 3;
    padding: 0 1;
    border: round $primary 25%;
    background: $surface;
}

#filter:focus {
    border: round $accent;
}

#hintbar {
    height: 1;
    padding: 0 1;
    background: $panel;
}

HelpScreen {
    align: center middle;
    background: $background 55%;
}

#help {
    width: 80;
    max-width: 96%;
    height: auto;
    max-height: 86%;
    padding: 1 2;
    border: round $primary 60%;
    background: $surface;
}

#help .help-heading {
    padding: 1 0 0 0;
    color: $text-accent;
    text-style: bold;
}

#help .help-block {
    padding: 0;
    height: auto;
}

ProfileScreen {
    align: center middle;
    background: $background 55%;
}

#profile-box {
    width: 88;
    max-width: 96%;
    height: auto;
    max-height: 80%;
    border: round $primary 60%;
    background: $surface;
}

#profile-list {
    height: auto;
    max-height: 14;
    padding: 1 1;
}

#profile-hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

/* ---------------------------------------------------------------- 连接面板 */
#conn-box {
    width: 100;
    max-width: 96%;
    height: 70%;
    border: round $primary 60%;
    background: $surface;
}

#conn-head {
    height: 1;
    padding: 0 1;
}

#conn-list {
    height: 1fr;
    padding: 1 1;
}

#conn-hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

/* ------------------------------------------------------------------ 规则表 */
#rules-box {
    width: 96;
    max-width: 96%;
    height: 80%;
    border: round $primary 60%;
    background: $surface;
}

#rules-list {
    height: 1fr;
    padding: 1 1;
}

#rules-hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}
